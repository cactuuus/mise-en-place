# Application Settings
APP_NAME='mise-en-place'
APP_DEBUG=false
APP_ENV=
APP_KEY=
APP_DOMAIN=
APP_URL=https://${APP_DOMAIN}
VITE_APP_NAME=${APP_NAME}
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Docker & Traefik Configuration
APP_IMAGE_NAME=${APP_NAME}-${APP_ENV}-app
APP_CONTAINER_NAME=${APP_NAME}-${APP_ENV}-fpm
WORKER_CONTAINER_NAME=${APP_NAME}-${APP_ENV}-worker
TRAEFIK_ROUTER_NAME=${APP_NAME}-${APP_ENV}-router

# Database Configuration (for the application)
DB_CONNECTION=mysql
DB_PORT=3306
DB_HOST=
MYSQL_ROOT_PASSWORD=
DB_DATABASE=${APP_NAME}-${APP_ENV}_db
DB_USERNAME=${APP_NAME}-${APP_ENV}_user
DB_PASSWORD=

# Laravel Services
SANCTUM_STATEFUL_DOMAINS=${APP_DOMAIN}
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=r2
LIVEWIRE_TEMP_DISK=r2
FILAMENT_FILESYSTEM_DISK=${FILESYSTEM_DISK}
MEDIA_DISK=${FILESYSTEM_DISK}
MEDIA_CONVERSIONS_DISK=${FILESYSTEM_DISK}

# Cloudflare R2 Configuration
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=
R2_BUCKET=
R2_ENDPOINT=
R2_USE_PATH_STYLE_ENDPOINT=

# Mail Configuration
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
