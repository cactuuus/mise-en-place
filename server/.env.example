# Application Settings
APP_NAME=mise
APP_ENV=
APP_KEY=
APP_DEBUG=
APP_DOMAIN=
APP_URL=https://${APP_DOMAIN}
VITE_APP_NAME=${APP_NAME}
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database Configuration (for the application)
DB_CONNECTION=mysql
DB_PORT=3306
DB_HOST=
DB_DATABASE=${APP_NAME}-${APP_ENV}
DB_USERNAME=${APP_NAME}-${APP_ENV}
DB_PASSWORD=

# Laravel Services
SANCTUM_STATEFUL_DOMAINS=${APP_DOMAIN}
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=r2
LIVEWIRE_TEMP_DISK=r2
FILAMENT_FILESYSTEM_DISK=${FILESYSTEM_DISK}
MEDIA_DISK=${FILESYSTEM_DISK}
MEDIA_CONVERSIONS_DISK=${FILESYSTEM_DISK}

PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=300
PHP_UPLOAD_MAX_FILESIZE=10M
PHP_POST_MAX_SIZE=10M
PHP_OPCACHE_ENABLE=1
PHP_OPCACHE_MEMORY_CONSUMPTION=128
PHP_OPCACHE_MAX_ACCELERATED_FILES=4000

BACKUP_NAME=laravel-backup
BACKUP_DISKS=r2,local

# Cloudflare R2 Configuration
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
R2_ENDPOINT=
R2_USE_PATH_STYLE_ENDPOINT=false

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# GitHub info
GITHUB_TOKEN=
GITHUB_USERNAME=

# Mail Configuration
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
